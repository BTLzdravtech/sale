<?xml version="1.0"?>
<odoo>
    <record id="view_contact_allow_any_user_as_salesman" model="ir.ui.view">
        <field name="name">res.partner.form.salesman</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <field name="property_product_pricelist" position="before">
                <field name="specific_property_product_pricelist" groups="product.group_product_pricelist"/>
            </field>
            <field name="property_product_pricelist" position="attributes">
                <attribute name="readonly">True</attribute>
            </field>
            <xpath expr="//page[@name='sales_purchases']//group[@name='sale']/field[@name='user_id']" position="attributes">
                <attribute name="groups">!sale_ux.group_allow_any_user_as_salesman</attribute>
            </xpath>
            <xpath expr="//page[@name='sales_purchases']//group[@name='sale']/field[@name='user_id']" position="after">
                <field name="user_id" domain="[]" groups="sale_ux.group_allow_any_user_as_salesman"/>
            </xpath>
        </field>
    </record>
</odoo>
